# ---------------------------------------------------------------------------
# BestChoice - production deployment configuration
#
# Copy to .env in this same directory, fill in every REQUIRED value, then run
# `docker compose up -d --build`. docker-compose.yml reads this file.
#
# Full reference for every variable, including local-dev-only ones:
#   docs/ENVIRONMENT.md
#
# .env is gitignored. Never commit it.
# ---------------------------------------------------------------------------

# --- Site -------------------------------------------------------------------
# Bare domain, no scheme, no trailing slash. Drives nginx server_name and the
# TLS certificate path, Django ALLOWED_HOSTS and CORS, and the frontend's API
# and canonical URLs. Changing it requires `docker compose build frontend`.
DOMAIN=bestchoice.in

# --- Django -----------------------------------------------------------------
# REQUIRED. Generate a fresh one, never reuse the dev default:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# --- Database ---------------------------------------------------------------
# REQUIRED. Postgres password for the `bestchoice` role. Set before the first
# `up` - it initialises the database volume and is awkward to change after.
DB_PASSWORD=

# --- Image storage (S3) -----------------------------------------------------
# REQUIRED in production. The backend refuses to start with DEBUG=False and no
# bucket, because product images would 404 with no visible error.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1
# Optional. CloudFront distribution domain, no scheme. Serves images from the
# CDN edge instead of directly from S3.
AWS_CLOUDFRONT_DOMAIN=

# --- Google sign-in ---------------------------------------------------------
# REQUIRED for customers to log in at all - Google is the only customer auth
# method. A "Web application" OAuth client ID from
# https://console.cloud.google.com/apis/credentials with https://$DOMAIN as an
# authorized JavaScript origin. Used by both backend and frontend.
GOOGLE_OAUTH_CLIENT_ID=

# --- Payments (Razorpay) ----------------------------------------------------
# REQUIRED to take payments. Dashboard > Settings > API Keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set when creating the webhook (Settings > Webhooks), pointing it at
# https://$DOMAIN/api/payment/webhook/. Without it, webhook calls are rejected.
RAZORPAY_WEBHOOK_SECRET=

# --- WhatsApp support -------------------------------------------------------
# Country code + number, digits only, no + or spaces. Used for the wa.me
# support button. e.g. 919876543210 for +91 98765 43210.
WHATSAPP_NUMBER=

# --- Transactional email ----------------------------------------------------
# Optional. Without EMAIL_HOST, order emails are silently skipped (they are
# sent with fail_silently=True), everything else keeps working.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Case-sensitive: only the exact string True enables TLS.
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@bestchoice.in
